# ── Server only (never exposed to any client) ───────────────────────────
DATABASE_URL=
DIRECT_URL=
SESSION_SECRET=
CSRF_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OBJECT_STORAGE_BUCKET_PRIVATE=kscwc-private
OBJECT_STORAGE_BUCKET_PUBLIC=kscwc-public
# ── Operational ─────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:5173
API_PORT=4000
CORS_ALLOWLIST=http://localhost:5173
SENTRY_DSN=                        # optional; error monitoring off when empty
MFA_ENC_KEY=                       # optional; key for encrypting TOTP secrets at rest (falls back to SESSION_SECRET) — keep STABLE
ADMIN_MFA_REQUIRED=false           # set true in production: admins must enrol TOTP MFA before using the console
DEFAULT_TIMEZONE=Asia/Kolkata
FID_GENERATION_PRICE_PAISE=500
WALLET_TOPUP_MIN_PAISE=
WALLET_TOPUP_MAX_PAISE=
MAX_UPLOAD_SIZE_BYTES=5242880
NODE_ENV=development
